# 이 파일을 .env.local로 복사해서 실제 값을 채우세요.
# cp .env.local.sample .env.local

# AssetERP DB 접속 정보 (읽기 전용 조회용)
TEST_DB="postgresql://user:password@host:5432/idmsdb"
LOCAL_DB="postgresql://user:password@localhost:5432/asseterpdb"
# yunhee table / prepare가 읽을 스키마 스냅샷 (yunhee make-dbml <이 이름>으로 생성)
YUNHEE_SCHEMA_ENV="LOCAL_DB"

# Ollama - qwen2.5-coder(추론/분석), bge-m3(임베딩)
# 주의: OLLAMA_HOST라는 이름은 Ollama 서버 자체의 bind address 환경변수와 겹치므로 쓰지 말 것.
YUNHEE_OLLAMA_URL="http://localhost:11434"
YUNHEE_OLLAMA_MODEL="qwen2.5-coder:14b"
YUNHEE_EMBED_MODEL="bge-m3:latest"
# 요청당 컨텍스트 토큰 수 (미지정 시 Ollama 기본 4096이라 긴 프롬프트가 잘림). 16384 ≈ VRAM 13GB
YUNHEE_NUM_CTX="16384"

# chromadb (docker, docs/docker-compose.yml 참고)
YUNHEE_CHROMA_HOST="localhost"
YUNHEE_CHROMA_PORT="8000"

# ASIS(AssetERP, GWT/GXT) 소스 루트 - yunhee가 레거시 페이지/매퍼를 찾는 기준
YUNHEE_ASIS_SRC_DIR="/home/kdy987/oms-data/src/Asset-ERP"

# API 스모크 테스트 (yunhee api)
YUNHEE_API_BASE_URL="http://localhost:8082/OMS"
YUNHEE_API_LOGIN_PATH="/api/auth/login"
# 기본 테넌트 (-t 생략 시). 순서: -t → .yunhee.toml [api] tenant → 이 값 → YUNHEE_TEST_COMPANY
YUNHEE_API_DEFAULT_TENANT="admin"
YUNHEE_TEST_ADMIN_USER="admin"
YUNHEE_TEST_ADMIN_PASS="password"
YUNHEE_TEST_COMPANY="admin"
YUNHEE_API_TENANT_HOST="{tenant}.localhost"
YUNHEE_API_TIMEOUT=15   # api 요청 타임아웃(초), --timeout으로 덮어쓰기 가능
YUNHEE_TEST_USER="user"   # --as user 로그인 계정
YUNHEE_TEST_PASS="password"
